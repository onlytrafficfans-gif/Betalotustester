{
  "expo": {
    "owner": "internetkartel",
    "name": "Lotus App Builder",
    "slug": "lotus-app-builder",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/lotus-app-icon.png",
    "scheme": "lotusappbuilder",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/lotus-app-icon.png",
      "bundleIdentifier": "com.lotus.appbuilder",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lotus.appbuilder",
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070809",
          "android": {
            "image": "./assets/images/lotus-app-icon.png",
            "imageWidth": 180
          }
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "apiBaseUrl": "",
      "router": {},
      "eas": {
        "projectId": "4d9ca0de-52e9-4091-9c0c-fe685715d21c"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
